      "id": "clamp",
      "weight": 1,
      "max_tokens": 384,
      "prompt": "Write one self-contained Python function named clamp. Return low when value is below low, high when above high, otherwise value. Return only a fenced python code block.",
      "language": "python",
      "graders": [
        {
          "type": "code_extract",
          "language": "python"
        },
        {
          "type": "python_parses"
        },
        {
          "type": "defines",
          "name": "clamp",
          "kind": "function"
        },
        {
          "type": "signature",
          "name": "clamp",
          "params": [
            "value",
            "low",
            "high"
          ]
        },
        {
          "type": "exec_python",
          "requires_exec": true,
          "tests": [
            "assert clamp(5, 0, 3) == 3",
            "assert clamp(-2, 0, 3) == 0"
          ]
        }
      ]
    },
